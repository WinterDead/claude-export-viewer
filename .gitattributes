# Launcher scripts: pin line endings so a Windows checkout (autocrlf) cannot
# hand a CRLF run.sh to bash, and the Windows-native scripts stay CRLF.
run.sh text eol=lf
run.bat text eol=crlf
run.ps1 text eol=crlf

# Vendored third-party assets: no EOL conversion ever — keep them
# byte-identical to what upstream shipped.
static/vendor/** -text

# Test fixtures are byte-exact artefacts of build_fixtures.py. The real
# archives are detected as binary anyway; corrupt_export.zip is deliberately
# text-like bytes and the current-format sets include a JSON manifest, so pin
# them all against EOL conversion.
tests/fixtures/*.zip -text
tests/fixtures/current/** -text
tests/fixtures/current_two_part/** -text
tests/fixtures/current_dangling/** -text

docs/briefs/** export-ignore
